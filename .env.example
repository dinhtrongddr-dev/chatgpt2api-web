# ==============================================================
# ChatGPT2API (Web Edition) - Configuration
# ==============================================================

# Master Auth Key (API key quản trị và cấp quyền gọi API)
# Tự đặt một chuỗi bí mật, bắt đầu bằng sk-... (Ví dụ: sk-chatgpt2api-secret-key-123456)
CHATGPT2API_AUTH_KEY=sk-your-super-secret-admin-key-here

# Cổng lắng nghe của service trên VPS (Mặc định: 3000)
CHATGPT2API_PORT=3000

# Địa chỉ IP bind (0.0.0.0 để cho phép truy cập từ bên ngoài VPS)
CHATGPT2API_HOST=0.0.0.0

# Base URL hiển thị (nếu có domain hoặc reverse proxy nginx, ví dụ: https://api.yourdomain.com)
# CHATGPT2API_BASE_URL=https://api.yourdomain.com

# Cấu hình Database (Mặc định để trống sẽ tự dùng SQLite trong ./data/chatgpt2api.db)
# Nếu muốn dùng PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Mật khẩu PostgreSQL nếu dùng docker-compose.postgres.yml
POSTGRES_PASSWORD=chatgpt2api_secret_pass

# Múi giờ
TZ=Asia/Ho_Chi_Minh

# Thread pool đồng thời xử lý request (mặc định: 120)
CHATGPT2API_THREAD_TOKENS=120
